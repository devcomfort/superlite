#!/usr/bin/env bash
# superlite tool launcher: bash on every platform (Git Bash on Windows), no .cmd wrappers.
#   bash <skill-dir>/scripts/sl <tool> [args...]
# <tool> is a script name without extension: incident, plan_tools, predict, pt_review,
# next_tasks, assign, run_tests, commit_task, build_prime, finish, graphify_gate, or
# probe_run (in ../probes). A tool with a .sh file runs under bash; a .py tool runs under
# the first working Python: $SUPERLITE_PYTHON, python3, python, py -3, then
# `uv run --no-project python`. Windows Store "python" stubs are skipped because they
# fail the version check. If no Python works, sl says so once and exits 3, and the
# caller logs the gap and continues without that tool.
set -u

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tool="${1:-}"
if [ -z "$tool" ]; then
  echo "usage: sl <tool> [args...]" >&2
  exit 2
fi
shift

for dir in "$here" "$here/../probes"; do
  if [ -f "$dir/$tool.sh" ]; then exec bash "$dir/$tool.sh" "$@"; fi
  if [ -f "$dir/$tool.py" ]; then script="$dir/$tool.py"; break; fi
done
if [ -z "${script:-}" ]; then
  echo "sl: unknown tool '$tool'" >&2
  exit 2
fi

# $SUPERLITE_PYTHON: an existing file (path may contain spaces) runs quoted; else word-split
# (a command with args such as `py -3`).
sp=()
if [ -n "${SUPERLITE_PYTHON:-}" ]; then
  if [ -f "$SUPERLITE_PYTHON" ]; then sp=("$SUPERLITE_PYTHON"); else read -r -a sp <<<"$SUPERLITE_PYTHON"; fi
fi

works() { "$@" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; }

if [ "${#sp[@]}" -gt 0 ] && works "${sp[@]}"; then
  exec "${sp[@]}" "$script" "$@"
fi
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && works "$py"; then exec "$py" "$script" "$@"; fi
done
if command -v py >/dev/null 2>&1 && works py -3; then exec py -3 "$script" "$@"; fi
if command -v uv >/dev/null 2>&1 && works uv run --no-project python; then
  exec uv run --no-project python "$script" "$@"
fi

echo "sl: no working Python 3.10+ found (tried \$SUPERLITE_PYTHON, python3, python, py -3, uv); '$tool' skipped" >&2
exit 3
