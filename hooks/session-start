#!/usr/bin/env bash
# SessionStart hook for the superlite plugin (Claude Code, Cursor, Copilot CLI, Muse and other SDK-style hosts)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

content=$(cat "${PLUGIN_ROOT}/skills/using-superlite/SKILL.md" 2>&1 || echo "Error reading using-superlite skill")

escape_for_json() {
    local s="$1"
    s="${s//\/\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\n}"
    s="${s//$'\r'/\r}"
    s="${s//$'\t'/\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$content")
session_context="You have superlite. Its 'superlite:using-superlite' skill follows; load other skills with the Skill tool.\n\n${escaped}"

# Emit only the field the current platform consumes:
# - Cursor sets CURSOR_PLUGIN_ROOT (and may also set CLAUDE_PLUGIN_ROOT) and expects additional_context (snake_case).
# - Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI or MUSE_PLUGIN_ROOT and expects
#   hookSpecificOutput.additionalContext (nested). It reads BOTH forms without deduplication, so never emit both.
# - Muse sets MUSE_PLUGIN_ROOT; it accepts the Claude-style nested output.
# - Copilot CLI (sets COPILOT_CLI=1) and unknown hosts expect top-level additionalContext (SDK standard).
# printf only (no heredoc) to avoid the bash 5.3+ heredoc hang.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context":"%s"}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$session_context"
else
  printf '{"additionalContext":"%s"}\n' "$session_context"
fi

exit 0
